#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: TVHeadend
# Starts TVHeadend
# ==============================================================================
declare args
declare -a args_array

bashio::log.info "Starting TVHeadend..."

args=$(bashio::config 'args')
bashio::log.info "Additional args ${args}"
read -r -a args_array <<< "${args//$'\n'/ }"

ingress_path=$(bashio::addon.ingress_entry)
bashio::log.info "Ingress path used as tvheadend http_root:  ${ingress_path}"

exec /usr/bin/tvheadend -u root -g root -c /config/tvheadend --http_root "${ingress_path}" "${args_array[@]}"
